<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Office Leave Portal - Main Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Flatpickr CSS for Calendar -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/themes/dark.min.css">
    
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: #0f172a; color: #f8fafc; display: flex; min-height: 100vh; overflow-x: hidden; }
        
        .sidebar { 
            width: 290px; 
            background: rgba(30, 41, 59, 0.85); 
            backdrop-filter: blur(16px); 
            border-right: 1px solid rgba(255,255,255,0.08); 
            padding: 25px 18px; 
            display: flex; 
            flex-direction: column; 
            justify-content: space-between; 
            height: 100vh;
            position: sticky;
            top: 0;
            z-index: 100;
            transition: transform 0.3s ease, width 0.3s ease;
        }

        .sidebar.hidden-sidebar {
            transform: translateX(-100%);
            width: 0;
            padding: 0;
            overflow: hidden;
            border: none;
        }

        .sidebar-top { display: flex; flex-direction: column; gap: 25px; }

        .sidebar-brand { 
            font-size: 18px; 
            font-weight: 700; 
            color: #fff; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            padding: 0 5px;
        }

        .brand-logo-img {
            width: 32px;
            height: 32px;
            background: #fff;
            border-radius: 8px;
            object-fit: contain;
            padding: 3px;
        }

        .nav-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }

        .nav-links a { 
            color: #94a3b8; 
            text-decoration: none; 
            padding: 12px 15px; 
            border-radius: 12px; 
            display: flex; 
            align-items: center; 
            gap: 14px; 
            font-weight: 500; 
            font-size: 14px;
            transition: background 0.2s ease, color 0.2s ease; 
            position: relative;
            cursor: pointer;
        }

        .nav-links a:hover { 
            background: rgba(99, 102, 241, 0.15); 
            color: #fff; 
        }

        .nav-links a.locked {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

        .lock-icon {
            margin-left: auto;
            font-size: 12px;
            color: #ef4444;
        }

        .sidebar-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .user-profile-box {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            background: rgba(15, 23, 42, 0.6);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .profile-avatar-container {
            position: relative;
            width: 45px;
            height: 45px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            color: white;
            font-size: 16px;
            overflow: hidden;
            object-fit: cover;
            border: 2px solid rgba(255,255,255,0.1);
        }

        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }

        .upload-overlay {
            position: absolute;
            bottom: 0;
            right: 0;
            background: #6366f1;
            color: white;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 9px;
            border: 1px solid #0f172a;
        }

        .profile-info {
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .profile-info h4 { font-size: 12px; color: #fff; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
        .profile-info p { font-size: 10px; color: #94a3b8; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

        .logout-btn { 
            background: rgba(239, 68, 68, 0.1); 
            color: #ef4444; 
            border: 1px solid rgba(239, 68, 68, 0.2); 
            padding: 10px 15px; 
            border-radius: 12px; 
            cursor: pointer; 
            font-weight: 600; 
            font-size: 13px;
            display: flex; 
            align-items: center; 
            justify-content: center;
            gap: 8px; 
            transition: all 0.3s ease; 
            width: 100%;
        }

        .logout-btn:hover { 
            background: #ef4444; 
            color: #fff; 
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

        .main-content { flex: 1; padding: 35px; overflow-y: auto; position: relative; z-index: 1; transition: all 0.3s ease; }

        .top-bar { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background: rgba(30, 41, 59, 0.7); 
            backdrop-filter: blur(12px);
            padding: 22px 30px; 
            border-radius: 20px; 
            border: 1px solid rgba(255,255,255,0.08); 
            margin-bottom: 25px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            gap: 15px;
            position: relative;
            z-index: 50; 
        }

        .toggle-sidebar-btn {
            background: rgba(99, 102, 241, 0.15);
            color: #6366f1;
            border: 1px solid rgba(99, 102, 241, 0.3);
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        .toggle-sidebar-btn:hover {
            background: #6366f1;
            color: #fff;
        }

        .user-info h3 { font-size: 20px; color: #fff; font-weight: 700; }
        .user-info p { font-size: 13px; color: #94a3b8; margin-top: 4px; }
        
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative; 
        }

        .notification-container {
            position: relative;
        }

        .notification-bell {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

        .notification-bell:hover {
            background: rgba(99, 102, 241, 0.2);
            color: #fff;
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            font-size: 10px;
            font-weight: 700;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #0f172a;
        }

        .notification-dropdown {
            position: absolute;
            right: 0;
            top: 52px;
            width: 320px;
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            z-index: 9999; 
            display: none;
            overflow: hidden;
        }

        .notification-dropdown.show {
            display: block;
        }

        .notif-header {
            padding: 14px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            background: rgba(15, 23, 42, 0.5);
        }

        .notif-list {
            max-height: 280px;
            overflow-y: auto;
        }

        .notif-item {
            padding: 12px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 12px;
            color: #cbd5e1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            transition: background 0.2s;
        }

        .notif-item:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        .notif-item.unread {
            background: rgba(99, 102, 241, 0.08);
        }

        .notif-time {
            font-size: 10px;
            color: #94a3b8;
        }

        .role-badge { 
            background: #6366f1; 
            color: white;
            padding: 6px 16px; 
            border-radius: 20px; 
            font-size: 12px; 
            font-weight: 600; 
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            white-space: nowrap;
        }

        .panel-section { 
            background: rgba(30, 41, 59, 0.7); 
            backdrop-filter: blur(12px);
            padding: 30px; 
            border-radius: 20px; 
            border: 1px solid rgba(255,255,255,0.08); 
            margin-bottom: 20px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            position: relative;
            z-index: 1;
        }
        
        .stats-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 240px;
            padding: 20px 24px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .stat-card.taken { background: #eef2ff; border: 1px solid #c7d2fe; }
        .stat-card.balance { background: #ecfdf5; border: 1px solid #a7f3d0; }

        .stat-card-title { font-size: 16px; font-weight: 700; }
        .stat-card.taken .stat-card-title { color: #3730a3; }
        .stat-card.balance .stat-card-title { color: #065f46; }

        .stat-badge-box { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 700; }
        .stat-circle {
            width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; font-weight: 700;
        }
        .stat-card.taken .stat-circle { background: #4f46e5; }
        .stat-card.balance .stat-circle { background: #059669; }

        .stat-card.taken .stat-badge-box span:last-child { color: #3730a3; }
        .stat-card.balance .stat-badge-box span:last-child { color: #065f46; }

        .clickable-card {
            cursor: pointer;
            transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(15, 23, 42, 0.5);
            padding: 22px;
            border-radius: 16px;
            margin-bottom: 25px;
        }
        .clickable-card:hover {
            border-color: rgba(56, 189, 248, 0.6);
            background: rgba(30, 41, 59, 0.95);
            transform: translateY(-2px);
        }

        .history-section {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(255,255,255,0.08);
            padding: 22px;
            border-radius: 16px;
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .month-filter-box {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .month-filter-box label { font-size: 12px; color: #94a3b8; font-weight: 600; }
        .month-filter-box select {
            background: rgba(30, 41, 59, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; padding: 6px 12px; border-radius: 8px; font-size: 13px; outline: none;
        }

        .table-responsive { width: 100%; overflow-x: auto; }

        .leave-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
        .leave-table th, .leave-table td { padding: 12px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); white-space: nowrap; }
        .leave-table th { color: #94a3b8; font-weight: 600; background: rgba(30, 41, 59, 0.5); }
        .leave-table td { color: #e2e8f0; }

        .status-badge {
            padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase;
        }
        .status-pending { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
        .status-approved { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
        .status-rejected { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

        .action-by-text {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 3px;
            display: block;
        }

        .action-btn-group { display: flex; gap: 6px; }
        .action-btn { padding: 5px 10px; border-radius: 6px; border: none; cursor: pointer; font-size: 12px; font-weight: 600; color: white; transition: opacity 0.2s; }
        .action-btn:hover { opacity: 0.85; }
        .btn-approve { background: #10b981; }
        .btn-reject { background: #ef4444; }

        .no-data { text-align: center; padding: 20px; color: #94a3b8; font-style: italic; }

        .back-btn {
            background: rgba(255, 255, 255, 0.1); color: #fff; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 15px; transition: background 0.2s ease;
        }
        .back-btn:hover { background: rgba(255, 255, 255, 0.2); }
        
        .hidden { display: none !important; }

        .leave-form { display: flex; flex-direction: column; gap: 20px; margin-top: 15px; }
        .form-group { display: flex; flex-direction: column; gap: 8px; }
        .form-group label { font-size: 13px; font-weight: 600; color: #cbd5e1; letter-spacing: 0.5px; }
        .form-group input, .form-group select, .form-group textarea {
            background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); padding: 12px 16px; border-radius: 12px; color: #fff; font-size: 14px; outline: none; transition: all 0.3s ease;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: #6366f1; box-shadow: 0 0 10px rgba(99, 102, 241, 0.2);
        }
        .form-group small { font-size: 11px; color: #94a3b8; }

        .submit-leave-btn {
            background: #6366f1; color: white; border: none; padding: 14px 24px; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3); margin-top: 10px;
        }
        .submit-leave-btn:hover { background: #4f46e5; box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }
    </style>
</head>
<body>

    <div class="sidebar" id="sidebarElement">
        <div class="sidebar-top">
            <div class="sidebar-brand">
                <img src="jd.jpg" alt="JD Logo" class="brand-logo-img"> Leave Portal
            </div>
            
            <ul class="nav-links">
                <li><a id="navDashboard"><i class="fa-solid fa-house"></i> Dashboard</a></li>
                <li><a id="menuEmployee"><i class="fa-solid fa-file-pen"></i> Employee Panel <i id="lockEmployee" class="fa-solid fa-lock lock-icon hidden"></i></a></li>
                <li><a id="menuTL"><i class="fa-solid fa-users-gear"></i> Team Leader <i id="lockTL" class="fa-solid fa-lock lock-icon hidden"></i></a></li>
                <li><a id="menuManagement"><i class="fa-solid fa-chart-pie"></i> Management <i id="lockManagement" class="fa-solid fa-lock lock-icon hidden"></i></a></li>
            </ul>
        </div>

        <div class="sidebar-bottom">
            <div class="user-profile-box">
                <div class="profile-avatar-container" id="avatarContainer" title="Click to change photo">
                    <div class="profile-avatar" id="profileAvatarBox">
                        <span id="profileInitial">U</span>
                    </div>
                    <div class="upload-overlay"><i class="fa-solid fa-camera"></i></div>
                </div>
                <input type="file" id="profileImageInput" accept="image/*" class="hidden">

                <div class="profile-info">
                    <h4 id="sidebarUserName">User Name</h4>
                    <p id="sidebarUserEmail">email@example.com</p>
                    <p id="sidebarUserRole">Role: N/A</p>
                    <p id="sidebarUserDept">Dept: N/A</p>
                </div>
            </div>
            <button class="logout-btn" id="logoutBtn">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </button>
        </div>
    </div>

    <div class="main-content">
        <div class="top-bar">
            <div style="display: flex; align-items: center; gap: 15px;">
                <button class="toggle-sidebar-btn" id="toggleSidebarBtn" title="Toggle Sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="user-info">
                    <h3 id="welcomeName">Welcome, User!</h3>
                    <p id="welcomeRoleAndDept">Department: Loading...</p>
                </div>
            </div>
            
            <div class="topbar-right">
                <!-- Notification Bell -->
                <div class="notification-container">
                    <div class="notification-bell" id="notificationBellBtn" title="Notifications">
                        <i class="fa-solid fa-bell"></i>
                        <div class="notification-badge hidden" id="notificationBadgeCount">0</div>
                    </div>
                    
                    <div class="notification-dropdown" id="notificationDropdown">
                        <div class="notif-header">
                            <span>Notifications</span>
                            <span style="font-size: 11px; color: #38bdf8; cursor: pointer;" id="markAllReadBtn">Mark all read</span>
                        </div>
                        <div class="notif-list" id="notificationListContainer">
                            <div class="notif-item">No notifications found</div>
                        </div>
                    </div>
                </div>

                <div>
                    <span id="roleBadge" class="role-badge">Role</span>
                </div>
            </div>
        </div>

        <!-- Dashboard Overview Panel -->
        <div id="dashboardPanel" class="panel-section">
            <h3><i class="fa-solid fa-house" style="color: #6366f1; margin-right: 8px;"></i>Dashboard Overview</h3>
            <p style="color: #94a3b8; font-size: 13px; margin: 8px 0 0 0;">Welcome to your office leave portal dashboard. Use the sidebar to navigate through panels.</p>
        </div>

        <!-- Employee Panel -->
        <div id="employeePanel" class="panel-section hidden">
            <div id="employeeCardView">
                <h3><i class="fa-solid fa-user-pen" style="color: #38bdf8; margin-right: 8px;"></i>Employee Panel</h3>
                <p style="color: #94a3b8; font-size: 13px; margin: 8px 0 20px 0;">Manage your leave applications and view history below.</p>
                
                <div class="stats-row">
                    <div class="stat-card taken">
                        <div class="stat-card-title">Taken Leaves:</div>
                        <div class="stat-badge-box">
                            <div class="stat-circle" id="takenLeavesCount">0</div>
                            <span>Days</span>
                        </div>
                    </div>
                    <div class="stat-card balance">
                        <div class="stat-card-title">Pending Balance:</div>
                        <div class="stat-badge-box">
                            <div class="stat-circle" id="pendingBalanceCount">12</div>
                            <span>Days</span>
                        </div>
                    </div>
                </div>

                <div id="openLeaveFormCard" class="clickable-card">
                    <h4 style="color: #fff; font-size: 16px; display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-paper-plane" style="color: #38bdf8;"></i> Apply for New Leave
                    </h4>
                    <p style="color: #94a3b8; font-size: 13px; margin-top: 6px;">Click here to submit a new leave request by specifying dates and reasons.</p>
                </div>

                <div class="history-section">
                    <div class="history-header">
                        <h4 style="color: #fff; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-clock-rotate-left" style="color: #10b981;"></i> My Leave History
                        </h4>
                        
                        <div class="month-filter-box">
                            <label for="monthFilter">Filter Month:</label>
                            <select id="monthFilter">
                                <option value="all">All Months</option>
                                <option value="01">January</option>
                                <option value="02">February</option>
                                <option value="03">March</option>
                                <option value="04">April</option>
                                <option value="05">May</option>
                                <option value="06">June</option>
                                <option value="07">July</option>
                                <option value="08">August</option>
                                <option value="09">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="leave-table">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Department</th>
                                    <th>Reason</th>
                                    <th>Report Date</th>
                                    <th>Full Leave</th>
                                    <th>Days</th>
                                    <th>Status & Action By</th>
                                </tr>
                            </thead>
                            <tbody id="leaveHistoryTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="employeeFormView" class="hidden">
                <button type="button" class="back-btn" id="backToCardBtn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                
                <h3><i class="fa-solid fa-paper-plane" style="color: #38bdf8; margin-right: 8px;"></i>Apply for New Leave</h3>
                <p style="color: #94a3b8; font-size: 13px; margin: 8px 0 0 0;">Fill out the details below to submit your leave request.</p>
                
                <form id="leaveRequestForm" class="leave-form">
                    <div class="form-group">
                        <label for="companyName">COMPANY NAME *</label>
                        <select id="companyName" required>
                            <option value="" disabled selected>કંપની પસંદ કરો</option>
                            <option value="WEBSANKUL">WEBSANKUL</option>
                            <option value="HOUSIVITY">HOUSIVITY</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="departmentName">DEPARTMENT *</label>
                        <select id="departmentName" required>
                            <option value="" disabled selected>ડિપાર્ટમેન્ટ પસંદ કરો</option>
                            <option value="FACULTY">FACULTY</option>
                            <option value="TYPING">TYPING</option>
                            <option value="CONTENT">CONTENT</option>
                            <option value="GRAPHIC">GRAPHIC</option>
