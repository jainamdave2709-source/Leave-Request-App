    <!-- Flatpickr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script>
        flatpickr("#reportFillDate", {
            dateFormat: "d/m/Y",
            allowInput: false,
            defaultDate: "today"
        });

        const userData = JSON.parse(localStorage.getItem("loggedInUser"));
        let userRole = "";
        let userDept = "N/A";
        let userIdentifier = "";
        let currentUserName = "";

        if (!userData) {
            window.location.href = "login.html";
        } else {
            userRole = userData.role;
            userIdentifier = userData.email || userData.name;
            currentUserName = userData.name;
            
            if (userData.departments) {
                if (Array.isArray(userData.departments)) {
                    userDept = userData.departments[0] || "N/A";
                } else if (typeof userData.departments === 'object') {
                    const values = Object.values(userData.departments);
                    userDept = values[0] || "N/A";
                } else {
                    userDept = userData.departments;
                }
            } else if (userData.department) {
                userDept = userData.department;
            }

            document.getElementById('welcomeName').innerText = `Welcome, ${userData.name}!`;
            document.getElementById('welcomeRoleAndDept').innerText = `Department: ${userDept}`;
            document.getElementById('roleBadge').innerText = userRole;

            document.getElementById('sidebarUserName').innerText = userData.name;
            document.getElementById('sidebarUserEmail').innerText = userData.email || 'No Email';
            document.getElementById('sidebarUserRole').innerText = `Role: ${userRole}`;
            document.getElementById('sidebarUserDept').innerText = `Dept: ${userDept}`;
            
            document.getElementById('employeeFullName').value = userData.name;

            const savedImage = localStorage.getItem(`profileImage_${userIdentifier}`);
            const avatarBox = document.getElementById('profileAvatarBox');
            if (savedImage) {
                avatarBox.innerHTML = `<img src="${savedImage}" alt="Profile">`;
            } else {
                document.getElementById('profileInitial').innerText = userData.name.charAt(0).toUpperCase();
            }

            const menuEmp = document.getElementById('menuEmployee');
            const lockEmp = document.getElementById('lockEmployee');
            const menuTL = document.getElementById('menuTL');
            const lockTL = document.getElementById('lockTL');
            const menuMgmt = document.getElementById('menuManagement');
            const lockMgmt = document.getElementById('lockManagement');

            if (userRole === "Employee") {
                menuEmp.classList.remove('locked'); lockEmp.classList.add('hidden');
                menuTL.classList.add('locked'); lockTL.classList.remove('hidden');
                menuMgmt.classList.add('locked'); lockMgmt.classList.remove('hidden');
            } else if (userRole === "TL") {
                menuEmp.classList.remove('locked'); lockEmp.classList.add('hidden');
                menuTL.classList.remove('locked'); lockTL.classList.add('hidden');
                menuMgmt.classList.add('locked'); lockMgmt.classList.remove('hidden');
            } else if (userRole === "Management") {
                menuEmp.classList.remove('locked'); lockEmp.classList.add('hidden');
                menuTL.classList.remove('locked'); lockTL.classList.add('hidden');
                menuMgmt.classList.remove('locked'); lockMgmt.classList.add('hidden');
            }
        }

        document.getElementById('toggleSidebarBtn').addEventListener('click', () => {
            const sidebar = document.getElementById('sidebarElement');
            sidebar.classList.toggle('hidden-sidebar');
        });

        document.getElementById('avatarContainer').addEventListener('click', () => {
            document.getElementById('profileImageInput').click();
        });

        document.getElementById('profileImageInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64Image = e.target.result;
                    document.getElementById('profileAvatarBox').innerHTML = `<img src="${base64Image}" alt="Profile">`;
                    if (userIdentifier) {
                        localStorage.setItem(`profileImage_${userIdentifier}`, base64Image);
                    }
                }
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('openLeaveFormCard').addEventListener('click', () => {
            document.getElementById('employeeCardView').classList.add('hidden');
            document.getElementById('employeeFormView').classList.remove('hidden');
        });

        document.getElementById('backToCardBtn').addEventListener('click', () => {
            document.getElementById('employeeFormView').classList.add('hidden');
            document.getElementById('employeeCardView').classList.remove('hidden');
        });

        const bellBtn = document.getElementById('notificationBellBtn');
        const notifDropdown = document.getElementById('notificationDropdown');

        bellBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            loadNotifications();
        });

        window.addEventListener('click', () => {
            if (notifDropdown.classList.contains('show')) {
                notifDropdown.classList.remove('show');
            }
        });

        notifDropdown.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        function getNotificationKey() {
            return `notifications_${userIdentifier}`;
        }

        function addNotification(targetUserIdentifier, message) {
            let userNotifs = JSON.parse(localStorage.getItem(`notifications_${targetUserIdentifier}`)) || [];
            userNotifs.unshift({
                id: Date.now(),
                message: message,
                read: false,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });
            localStorage.setItem(`notifications_${targetUserIdentifier}`, JSON.stringify(userNotifs));
        }

        function loadNotifications() {
            const listContainer = document.getElementById('notificationListContainer');
            const badgeCount = document.getElementById('notificationBadgeCount');
            
            if (userRole === 'TL') {
                let deptNotifsKey = `dept_notifications_${userDept}`;
                let deptNotifs = JSON.parse(localStorage.getItem(deptNotifsKey)) || [];
                let personalNotifs = JSON.parse(localStorage.getItem(getNotificationKey())) || [];
                let combined = [...deptNotifs, ...personalNotifs];
                
                listContainer.innerHTML = '';

                let unreadCount = combined.filter(n => !n.read).length;
                if (unreadCount > 0) {
                    badgeCount.innerText = unreadCount;
                    badgeCount.classList.remove('hidden');
                } else {
                    badgeCount.classList.add('hidden');
                }

                if (combined.length === 0) {
                    listContainer.innerHTML = `<div class="notif-item">No notifications found</div>`;
                    return;
                }

                combined.forEach(notif => {
                    const div = document.createElement('div');
                    div.className = `notif-item ${notif.read ? '' : 'unread'}`;
                    div.innerHTML = `
                        <span>${notif.message}</span>
                        <span class="notif-time">${notif.time}</span>
                    `;
                    listContainer.appendChild(div);
                });
            } else {
                let userNotifs = JSON.parse(localStorage.getItem(getNotificationKey())) || [];

                listContainer.innerHTML = '';

                let unreadCount = userNotifs.filter(n => !n.read).length;
                if (unreadCount > 0) {
                    badgeCount.innerText = unreadCount;
                    badgeCount.classList.remove('hidden');
                } else {
                    badgeCount.classList.add('hidden');
                }

                if (userNotifs.length === 0) {
                    listContainer.innerHTML = `<div class="notif-item">No notifications found</div>`;
                    return;
                }

                userNotifs.forEach(notif => {
                    const div = document.createElement('div');
                    div.className = `notif-item ${notif.read ? '' : 'unread'}`;
                    div.innerHTML = `
                        <span>${notif.message}</span>
                        <span class="notif-time">${notif.time}</span>
                    `;
                    listContainer.appendChild(div);
                });
            }
        }

        document.getElementById('markAllReadBtn').addEventListener('click', () => {
            if (userRole === 'TL') {
                let deptNotifsKey = `dept_notifications_${userDept}`;
                let deptNotifs = JSON.parse(localStorage.getItem(deptNotifsKey)) || [];
                deptNotifs = deptNotifs.map(n => ({ ...n, read: true }));
                localStorage.setItem(deptNotifsKey, JSON.stringify(deptNotifs));

                let personalNotifs = JSON.parse(localStorage.getItem(getNotificationKey())) || [];
                personalNotifs = personalNotifs.map(n => ({ ...n, read: true }));
                localStorage.setItem(getNotificationKey(), JSON.stringify(personalNotifs));
            } else {
                let userNotifs = JSON.parse(localStorage.getItem(getNotificationKey())) || [];
                userNotifs = userNotifs.map(n => ({ ...n, read: true }));
                localStorage.setItem(getNotificationKey(), JSON.stringify(userNotifs));
            }
            loadNotifications();
        });

        function switchTab(tabName) {
            if (tabName !== 'dashboard') {
                let hasAccess = false;
                if (userRole === "Employee") {
                    if (tabName === 'employee') hasAccess = true;
                } else if (userRole === "TL") {
                    if (tabName === 'employee' || tabName === 'tl') hasAccess = true;
                } else if (userRole === "Management") {
                    if (tabName === 'employee' || tabName === 'tl' || tabName === 'management') hasAccess = true;
                }

                if (!hasAccess) {
                    alert(`🔒 Access Denied! This panel is locked for your current role.`);
                    return;
                }
            }

            document.getElementById('employeeFormView').classList.add('hidden');
            document.getElementById('employeeCardView').classList.remove('hidden');

            const allLinks = document.querySelectorAll('.nav-links a');
            allLinks.forEach(link => {
                link.style.background = 'transparent';
                link.style.color = '#94a3b8';
                link.style.boxShadow = 'none';
            });

            document.getElementById('dashboardPanel').classList.add('hidden');
            document.getElementById('employeePanel').classList.add('hidden');
            document.getElementById('tlPanel').classList.add('hidden');
            document.getElementById('managementPanel').classList.add('hidden');

            let activeLink = null;
            if (tabName === 'dashboard') {
                activeLink = document.getElementById('navDashboard');
                document.getElementById('dashboardPanel').classList.remove('hidden');
            } else if (tabName === 'employee') {
                activeLink = document.getElementById('menuEmployee');
                document.getElementById('employeePanel').classList.remove('hidden');
                loadLeaveHistory(); 
            } else if (tabName === 'tl') {
                activeLink = document.getElementById('menuTL');
                document.getElementById('tlPanel').classList.remove('hidden');
                loadTlApprovals();
            } else if (tabName === 'management') {
                activeLink = document.getElementById('menuManagement');
                document.getElementById('managementPanel').classList.remove('hidden');
            }

            if (activeLink) {
                activeLink.style.background = '#6366f1';
                activeLink.style.color = '#ffffff';
                activeLink.style.boxShadow = '0 4px 15px rgba(99, 102, 241, 0.4)';
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            switchTab('dashboard');
            loadNotifications();
        });

        document.getElementById('navDashboard').addEventListener('click', (e) => { e.preventDefault(); switchTab('dashboard'); });
        document.getElementById('menuEmployee').addEventListener('click', (e) => { e.preventDefault(); switchTab('employee'); });
        document.getElementById('menuTL').addEventListener('click', (e) => { e.preventDefault(); switchTab('tl'); });
        document.getElementById('menuManagement').addEventListener('click', (e) => { e.preventDefault(); switchTab('management'); });

        const GLOBAL_LEAVES_KEY = "globalOfficeLeaveRequests";

        function loadLeaveHistory() {
            const tbody = document.getElementById('leaveHistoryTableBody');
            const selectedMonth = document.getElementById('monthFilter').value;
            const allLeaves = JSON.parse(localStorage.getItem(GLOBAL_LEAVES_KEY)) || [];

            const myLeaves = allLeaves.filter(l => l.employeeEmail === userIdentifier || l.employeeFullName.toLowerCase() === userData.name.toLowerCase());

            tbody.innerHTML = '';

            let filteredLeaves = myLeaves;
            if (selectedMonth !== 'all') {
                filteredLeaves = myLeaves.filter(leave => {
                    if (leave.reportFillDate) {
                        const parts = leave.reportFillDate.split('/');
                        if (parts.length === 3) {
                            return parts[1] === selectedMonth;
                        }
                    }
                    return false;
                });
            }

            let totalTakenDays = 0;
            filteredLeaves.forEach(leave => {
                if (leave.status === 'Approved') {
                    totalTakenDays += parseFloat(leave.totalLeaveDays) || 0;
                }
            });

            document.getElementById('takenLeavesCount').innerText = totalTakenDays;
            
            const totalAllowedQuota = 12; 
            let pendingBalance = totalAllowedQuota - totalTakenDays;
            document.getElementById('pendingBalanceCount').innerText = pendingBalance >= 0 ? pendingBalance : 0;

            if (filteredLeaves.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="no-data">No leave history found for this period.</td></tr>`;
                return;
            }

            filteredLeaves.forEach(leave => {
                let badgeClass = 'status-pending';
                if (leave.status === 'Approved') badgeClass = 'status-approved';
                else if (leave.status === 'Rejected') badgeClass = 'status-rejected';

                let actionByName = leave.actionBy ? `<span class="action-by-text">By: ${leave.actionBy}</span>` : '';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${leave.companyName}</td>
                    <td>${leave.departmentName}</td>
                    <td>${leave.leaveReason}</td>
                    <td>${leave.reportFillDate}</td>
                    <td>${leave.fullLeaveDate || '-'}</td>
                    <td>${leave.totalLeaveDays}</td>
                    <td>
                        <span class="status-badge ${badgeClass}">${leave.status || 'Pending'}</span>
                        ${actionByName}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function loadTlApprovals() {
            const tbody = document.getElementById('tlApprovalTableBody');
            const allLeaves = JSON.parse(localStorage.getItem(GLOBAL_LEAVES_KEY)) || [];

            tbody.innerHTML = '';

            let departmentLeaves = allLeaves;
            if (userRole !== 'Management') {
                departmentLeaves = allLeaves.filter(l => l.departmentName.toUpperCase() === userDept.toUpperCase());
            }

            if (departmentLeaves.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="no-data">No leave requests found for your department.</td></tr>`;
                return;
            }

            departmentLeaves.forEach((leave) => {
                let badgeClass = 'status-pending';
                if (leave.status === 'Approved') badgeClass = 'status-approved';
                else if (leave.status === 'Rejected') badgeClass = 'status-rejected';

                let actionByName = leave.actionBy ? `<span class="action-by-text">By: ${leave.actionBy}</span>` : '';

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${leave.employeeFullName}</strong></td>
                    <td>${leave.departmentName}</td>
                    <td>${leave.leaveReason}</td>
                    <td>${leave.reportFillDate}</td>
                    <td>${leave.totalLeaveDays}</td>
                    <td>
                        <span class="status-badge ${badgeClass}">${leave.status || 'Pending'}</span>
                        ${actionByName}
                    </td>
                    <td>
                        <div class="action-btn-group">
                            <button class="action-btn btn-approve" onclick="updateLeaveStatus(${leave.id}, 'Approved')"><i class="fa-solid fa-check"></i></button>
                            <button class="action-btn btn-reject" onclick="updateLeaveStatus(${leave.id}, 'Rejected')"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        window.updateLeaveStatus = function(leaveId, newStatus) {
            let allLeaves = JSON.parse(localStorage.getItem(GLOBAL_LEAVES_KEY)) || [];
            const leaveIndex = allLeaves.findIndex(l => l.id === leaveId);
            if (leaveIndex !== -1) {
                allLeaves[leaveIndex].status = newStatus;
                allLeaves[leaveIndex].actionBy = currentUserName; 
                localStorage.setItem(GLOBAL_LEAVES_KEY, JSON.stringify(allLeaves));
                
                const targetEmpIdentifier = allLeaves[leaveIndex].employeeEmail;
                addNotification(targetEmpIdentifier, `Your leave request for ${allLeaves[leaveIndex].totalLeaveDays} day(s) has been ${newStatus} by ${currentUserName}.`);

                loadTlApprovals();
                alert(`✅ Leave request successfully marked as ${newStatus}!`);
            }
        };

        document.getElementById('monthFilter').addEventListener('change', loadLeaveHistory);

        function isValidDateString(str) {
            if (!str || str.trim() === "") return true;
            const dates = str.split(',').map(d => d.drim ? d.trim() : d.trim());
            const dateRegex = /^(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[012])\/\d{4}$/;
            for (let d of dates) {
                if (!dateRegex.test(d)) return false;
            }
            return true;
        }

        document.getElementById('leaveRequestForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const fullName = document.getElementById('employeeFullName').value.trim();
            if (!fullName.includes(' ')) {
                alert('⚠️ ભૂલ: નામ અને અટક (Surname) વચ્ચે સ્પેસ મૂકીને બંને ફરજિયાત લખવું.');
                return;
            }

            const fullLeaveVal = document.getElementById('fullLeaveDate').value.trim();
            const firstHalfVal = document.getElementById('firstHalfDate').value.trim();
            const secondHalfVal = document.getElementById('secondHalfDate').value.trim();

            if (!isValidDateString(fullLeaveVal) || !isValidDateString(firstHalfVal) || !isValidDateString(secondHalfVal)) {
                alert('⚠️ ભૂલ: તારીખ ફરજિયાત dd/mm/yyyy ફોર્મેટમાં જ હોવી જોઈએ!');
                return;
            }

            const selectedDept = document.getElementById('departmentName').value;

            const newLeave = {
                id: Date.now(),
                employeeEmail: userIdentifier,
                companyName: document.getElementById('companyName').value,
                departmentName: selectedDept,
                employeeFullName: fullName,
                leaveReason: document.getElementById('leaveReason').value,
                reportFillDate: document.getElementById('reportFillDate').value,
                fullLeaveDate: fullLeaveVal,
                firstHalfDate: firstHalfVal,
                secondHalfDate: secondHalfVal,
                totalLeaveDays: document.getElementById('totalLeaveDays').value,
                status: 'Pending',
                actionBy: '', 
                timestamp: new Date().toISOString()
            };

            let allLeaves = JSON.parse(localStorage.getItem(GLOBAL_LEAVES_KEY)) || [];
            allLeaves.unshift(newLeave);
            localStorage.setItem(GLOBAL_LEAVES_KEY, JSON.stringify(allLeaves));

            addNotification(userIdentifier, `Your leave application was successfully submitted to ${selectedDept} department TL.`);

            let deptNotifsKey = `dept_notifications_${selectedDept}`;
            let deptNotifs = JSON.parse(localStorage.getItem(deptNotifsKey)) || [];
            deptNotifs.unshift({
                id: Date.now(),
                message: `New leave request received from ${fullName} (${selectedDept})`,
                read: false,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });
            localStorage.setItem(deptNotifsKey, JSON.stringify(deptNotifs));

            alert('✅ Success! Your leave request has been submitted to your department TL.');
            this.reset();
            document.getElementById('employeeFullName').value = userData.name;
            
            document.getElementById('employeeFormView').classList.add('hidden');
            document.getElementById('employeeCardView').classList.remove('hidden');
            loadLeaveHistory();
        });

        document.getElementById('logoutBtn').addEventListener('click', () => {
            localStorage.removeItem("loggedInUser");
            window.location.href = "login.html";
        });
    </script>
</body>
</html>
